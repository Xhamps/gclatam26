{
  "mcpServers": {
    "gopls": {
      "command": "gopls",
      "args": ["mcp"]
    },
    "godoctor": {
      "command": "godoctor",
      "args": ["mcp"]
    },
    "google-developer-knowledge": {
      "httpUrl": "https://developerknowledge.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      },
      "timeout": 30000,
      "headers": {
        "X-goog-user-project": ">>>>COLOQUE SEU VERDADEIRO PROJECT_ID AQUI<<<<<<"
      }
    },
    "agentskills": {
      "command": "npx",
      "args": ["-y", "agentskills-mcp"]
    }
  }
}
